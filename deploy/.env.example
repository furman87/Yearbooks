# Copy this file to .env.production on the server and adjust values as needed.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://*:8387
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

YearbookPath=/app/yearbooks
Viewer__ClickZoomLevel=1.75
Viewer__DesktopClickZoomLevel=1.75
Viewer__MobileClickZoomLevel=2.25
AllowedHosts=yearbooks.fu87.app;localhost;127.0.0.1

# Local default from deploy/ is ../../YearbookData/yearbook-data.
# Production example:
YEARBOOK_DATA_PATH=/opt/yearbook-data

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information

RequestTimeout=300
ResponseCacheMaxAge=3600
MaxRequestBodySize=52428800